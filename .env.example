# Anthropic API key for the agent (Phase 2): https://console.anthropic.com
ANTHROPIC_API_KEY=

# FACEIT Data API key (server-side key from https://developers.faceit.com). Required for FACEIT tools only.
FACEIT_API_KEY=

# Leetify public API key (https://leetify.com/app/developer). Optional: higher rate limits.
LEETIFY_API_KEY=

# Folder with your .dem files, so ingest_demo accepts bare file names. Optional.
CS2_DEMO_DIR=

# Where parsed demos are cached. Defaults to ~/.cs2-analyst/cache
# CS2_CACHE_DIR=

# Seconds to cache FACEIT/Leetify responses. Default 300.
# CS2_HTTP_CACHE_TTL=300

# Where agent run traces are written. Default ./traces
# CS2_TRACE_DIR=traces

# Optional: CS2 game\csgo folder for "Watch in CS2" in the web app (auto-detected in the default Steam folder)
CS2_GAME_DIR=
